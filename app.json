{
  "expo": {
    "name": "RealOr",
    "slug": "RealOr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "online.latchos.realor",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "RealOr requires camera access to capture film-simulated 35mm photographs.",
        "NSPhotoLibraryUsageDescription": "RealOr requires photo library access to save developed frames to your darkroom.",
        "NSPhotoLibraryAddUsageDescription": "RealOr needs permission to save developed photographs to your camera roll.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uddeshmulik.RealOr"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "RealOr needs photo library access to save developed photos.",
          "savePhotosPermission": "RealOr saves developed photos to your camera roll.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f59b0ef9-8159-4e13-9b26-59485e716bd7"
      }
    }
  }
}
